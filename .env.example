# Copy to .env and fill in your keys:  cp .env.example .env
# .env is gitignored. Never put real keys or webhook URLs in this file.

APP_TITLE=AI Regulation Assistant
TEAM_NAME=One Piece
KNOWLEDGE_BASE=EU AI Act (Regulation (EU) 2024/1689) · NIST AI RMF 1.0

# Chat model: Grok through xAI. Embeddings and reranking run on your machine.
LLM_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Grok prices in $ per million tokens (docs.x.ai), for the cost tracker
CHAT_PRICE_INPUT_PER_M=1.25
CHAT_PRICE_OUTPUT_PER_M=2.50
BUDGET_USD=5.0

# Retrieval: hybrid search, then the cross-encoder keeps the best TOP_K passages.
# Set RERANK_MIN_SCORE to the value suggested by: python scripts/eval_runner.py --mode retrieval
RETRIEVAL_MODE=hybrid
TOP_K=8
USE_RERANK=true
RERANK_MIN_SCORE=-5.4
QUERY_EXPANSION=false

# Agent
AGENT_MAX_STEPS=6
AGENT_TOP_K=3

# Prompt injection test passage: keep false, switch to true only for the demo
INJECTION_TEST=false

# send_message: auto = webhook if WEBHOOK_URL is set, else dry run
SEND_BACKEND=auto
WEBHOOK_URL=
WEBHOOK_FORMAT=slack
DEFAULT_CHANNEL=
ALLOWED_CHANNELS=
